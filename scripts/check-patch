#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (C) 2026 Szymon Wilczek
#
# Check the commits in base..head before a branch is offered for review.

set -u

repository_root=$(git rev-parse --show-toplevel 2>/dev/null)
if [[ -z ${repository_root:-} ]]; then
    printf 'FAIL repository\n'
    printf 'fix: run this script from inside the EOLA git repository.\n'
    exit 2
fi
cd "$repository_root" || exit 2

# shellcheck source=scripts/lib/commit-limits.sh
. scripts/lib/commit-limits.sh

failure_count=0

usage() {
    cat <<'USAGE'
usage: scripts/check-patch [<base-commit> [<head-commit>]]

Checks the commits in base..head. If base is omitted, the script uses the
upstream merge-base, origin/eola-next, or eola-next, in that order. Head
defaults to HEAD.

Checks:
  - a good GPG or SSH signature on every commit,
  - a Developer Certificate of Origin Signed-off-by trailer, preceded by
    one blank line,
  - subjects within 75 columns and without a Conventional Commits scope,
  - body lines within 75 columns, except indented lines, trailers and
    lines carrying a URL,
  - a prose body, without Problem: or Solution: headings,
  - body detail proportional to the change (note only),
  - the branch name within 75 columns, and the pull request title under
    the subject rules when PATCH_TITLE is set,
  - trailing whitespace in patches and commit messages, and trailing blank
    lines in changed files,
  - a strict documentation build and sphinx-lint when a reStructuredText
    file or Documentation/ changes (skipped if the tools are missing).

Merge commits are exempt from the commit message checks.

Environment:
  PATCH_BRANCH      branch name to check in place of the current branch
  PATCH_TITLE       pull request title, checked under the subject rules
  PATCH_SIGNATURES  "github" asks the GitHub API whether each commit is
                    verified, for GITHUB_REPOSITORY with the GH_TOKEN token;
                    unset, the local keyring decides

Each check prints one line: PASS, FAIL with a fix: line, SKIP with the
reason, or INFO. The exit status is 1 when any check fails.
USAGE
}

pass() {
    printf 'PASS %s\n' "$1"
}

fail() {
    printf 'FAIL %s\n' "$1"
    printf 'fix: %s\n' "$2"
    failure_count=$((failure_count + 1))
}

skip() {
    printf 'SKIP %s\n' "$1"
    printf '     %s\n' "$2"
}

note() {
    printf 'INFO %s\n' "$1"
}

short_commit() {
    git rev-parse --short=12 "$1"
}

commit_subject() {
    git log -1 --format=%s "$1"
}

report_commit() {
    printf '  %s %s%s\n' "$(short_commit "$1")" "$(commit_subject "$1")" "${2:-}"
}

write_commit_message() {
    git cat-file commit "$1" | sed '1,/^$/d' >"$2"
}

is_merge_commit() {
    local parent_count

    parent_count=$(git rev-list --parents -n1 "$1" | awk '{ print NF - 1 }')
    ((parent_count > 1))
}

resolve_base() {
    local upstream

    if upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null); then
        git merge-base HEAD "$upstream"
        return
    fi
    if git rev-parse --verify --quiet origin/eola-next >/dev/null; then
        git merge-base HEAD origin/eola-next
        return
    fi
    if git rev-parse --verify --quiet eola-next >/dev/null; then
        git merge-base HEAD eola-next
        return
    fi
    return 1
}

# %G? is G for a good signature and U for a good one from an untrusted
# key; anything else is bad, expired, revoked, unverifiable or absent.
local_signature_status() {
    local signature_status

    signature_status=$(git log -1 --format='%G?' "$1")
    case "$signature_status" in
        G | U) printf 'good' ;;
        *) printf '%s' "$signature_status" ;;
    esac
}

# A runner holds no contributor keys, so it asks GitHub, which checks the
# signature against the keys registered on the author's account.
github_signature_status() {
    local verification

    if ! verification=$(gh api "repos/$GITHUB_REPOSITORY/commits/$1" \
                            --jq '.commit.verification | "\(.verified) \(.reason)"' 2>/dev/null); then
        verification="false not found on GitHub"
    fi
    case "$verification" in
        "true "*) printf 'good' ;;
        *) printf '%s' "${verification#false }" ;;
    esac
}

check_commit_signatures() {
    local result=0
    local commit signature_status

    if [[ ${PATCH_SIGNATURES:-} == github ]] &&
           { [[ -z ${GITHUB_REPOSITORY:-} ]] || ! command -v gh >/dev/null 2>&1; }; then
        fail "commit signatures" \
             "PATCH_SIGNATURES=github needs gh, GITHUB_REPOSITORY and GH_TOKEN."
        return
    fi

    for commit in "$@"; do
        if [[ ${PATCH_SIGNATURES:-} == github ]]; then
            signature_status=$(github_signature_status "$commit")
        else
            signature_status=$(local_signature_status "$commit")
        fi
        if [[ $signature_status != good ]]; then
            report_commit "$commit" " (signature: $signature_status)"
            result=1
        fi
    done

    if ((result == 0)); then
        pass "commit signatures"
    else
        fail "commit signatures" \
             "sign every commit (git commit -S, or commit.gpgsign set to true) so GitHub marks it verified."
    fi
}

check_signoff() {
    local result=0
    local commit message_file

    message_file=$(mktemp)
    for commit in "$@"; do
        write_commit_message "$commit" "$message_file"
        if ! grep -Eq '^Signed-off-by: [^<]+ <[^>]+>$' "$message_file"; then
            report_commit "$commit" " (no Signed-off-by)"
            result=1
            continue
        fi
        if ! awk '
            /^Signed-off-by:/ {
                if (FNR == 1 || (previous_line != "" && previous_line !~ /^[A-Za-z0-9-]+-by:/))
                    misplaced = 1
            }
            { previous_line = $0 }
            END { exit misplaced ? 1 : 0 }
        ' "$message_file"; then
            report_commit "$commit" " (Signed-off-by not preceded by one blank line)"
            result=1
        fi
    done
    rm -f "$message_file"

    if ((result == 0)); then
        pass "Developer Certificate of Origin"
    else
        fail "Developer Certificate of Origin" \
             "add the trailer with git commit --amend -s, after one blank line."
    fi
}

check_subject_text() {
    local subject=$1
    local location=$2
    local conventional_scope='^[A-Za-z][A-Za-z0-9_-]*\([^)]*\)!?:'
    local result=0

    if [[ $subject =~ $conventional_scope ]]; then
        printf '  %s: Conventional Commits scope: %s\n' "$location" "$subject"
        result=1
    fi
    if ((${#subject} > COMMIT_COLUMNS)); then
        printf '  %s: %d columns, limit %d: %s\n' \
               "$location" "${#subject}" "$COMMIT_COLUMNS" "$subject"
        result=1
    fi
    if [[ $subject =~ ^[^\ :]+/[^\ :]*: ]]; then
        note "$location: \"/\" joins two areas changed together; a submodule is \"a: b:\"."
    elif [[ $subject =~ ^[^\ :]+:\ [^\ :]+: ]]; then
        note "$location: \": \" names a submodule; two areas changed together are \"a/b:\"."
    fi
    return "$result"
}

check_commit_subjects() {
    local result=0
    local commit

    for commit in "$@"; do
        check_subject_text "$(commit_subject "$commit")" "$(short_commit "$commit")" ||
            result=1
    done

    if ((result == 0)); then
        pass "commit subjects"
    else
        fail "commit subjects" \
             "use a bare area prefix such as \"spec: heartbeat:\" and keep the subject within $COMMIT_COLUMNS columns."
    fi
}

check_branch_name() {
    local branch

    branch=${PATCH_BRANCH:-$(git symbolic-ref --quiet --short HEAD || true)}
    case "$branch" in
        "" | eola-next | main)
            skip "branch name" "not on a feature branch."
            return
            ;;
    esac

    if ((${#branch} > COMMIT_COLUMNS)); then
        printf '  %s: %d columns, limit %d\n' "$branch" "${#branch}" "$COMMIT_COLUMNS"
        fail "branch name" "rename the branch with git branch -m."
    else
        pass "branch name"
    fi
}

check_pull_request_title() {
    if [[ -z ${PATCH_TITLE:-} ]]; then
        skip "pull request title" "PATCH_TITLE is not set."
        return
    fi

    if check_subject_text "$PATCH_TITLE" "pull request title"; then
        pass "pull request title"
    else
        fail "pull request title" \
             "edit the title under the subject rules; the commit subject of a single-commit pull request fits."
    fi
}

check_body_line_length() {
    local result=0
    local commit long_lines

    for commit in "$@"; do
        long_lines=$(
            git log -1 --format=%B "$commit" | awk '
                NR == 1 { next }
                length($0) > ENVIRON["COMMIT_COLUMNS"] + 0 &&
                $0 ~ /[[:space:]]/ &&
                $0 !~ ENVIRON["COMMIT_LINE_EXEMPT"] {
                    printf "    line %d: %d columns\n", NR, length($0)
                }
            '
        )
        if [[ -n $long_lines ]]; then
            report_commit "$commit"
            printf '%s\n' "$long_lines"
            result=1
        fi
    done

    if ((result == 0)); then
        pass "commit body line length"
    else
        fail "commit body line length" \
             "run scripts/format-patch over the same base..head range, then review the rewrapped bodies."
    fi
}

check_body_prose() {
    local result=0
    local commit

    for commit in "$@"; do
        if git log -1 --format=%B "$commit" | grep -Eq '^(Problem|Solution):'; then
            report_commit "$commit"
            result=1
        fi
    done

    if ((result == 0)); then
        pass "commit body prose"
    else
        fail "commit body prose" \
             "drop the Problem: and Solution: headings; the first paragraph states the problem and the next one the change."
    fi
}

commit_body_words() {
    git log -1 --format=%B "$1" | awk '
        NR == 1 { next }
        /^[A-Za-z0-9-]+-by:[[:space:]]/ { next }
        { word_count += NF }
        END { print word_count + 0 }
    '
}

commit_change_size() {
    git diff-tree --no-commit-id --numstat -r "$1" | awk '
        {
            file_count++
            if ($1 ~ /^[0-9]+$/)
                line_count += $1
            if ($2 ~ /^[0-9]+$/)
                line_count += $2
        }
        END { print file_count + 0, line_count + 0 }
    '
}

check_body_detail() {
    local result=0
    local commit word_count file_count line_count minimum_words

    for commit in "$@"; do
        word_count=$(commit_body_words "$commit")
        read -r file_count line_count < <(commit_change_size "$commit")
        minimum_words=0
        if ((file_count >= 5 || line_count >= 100)); then
            minimum_words=80
        elif ((file_count >= 3 || line_count >= 40)); then
            minimum_words=40
        fi
        if ((minimum_words > 0 && word_count < minimum_words)); then
            report_commit "$commit" \
                          ": $file_count files, $line_count lines, $word_count words, expected $minimum_words"
            result=1
        fi
    done

    if ((result == 0)); then
        pass "commit body detail"
    else
        note "commit body detail: consider saying which modules the change touches, which contract it affects and what a reviewer should check."
    fi
}

check_patch_whitespace() {
    local result=0
    local commit output_file

    output_file=$(mktemp)
    for commit in "$@"; do
        if ! git show --check --format= "$commit" >"$output_file" 2>&1; then
            report_commit "$commit"
            sed 's/^/    /' "$output_file"
            result=1
        fi
    done
    if ! git diff --check >"$output_file" 2>&1; then
        printf '  unstaged changes:\n'
        sed 's/^/    /' "$output_file"
        result=1
    fi
    if ! git diff --check --cached >"$output_file" 2>&1; then
        printf '  staged changes:\n'
        sed 's/^/    /' "$output_file"
        result=1
    fi
    rm -f "$output_file"

    if ((result == 0)); then
        pass "patch whitespace"
    else
        fail "patch whitespace" \
             "remove the reported whitespace; a heading underline that git reads as a conflict marker gets one more character."
    fi
}

trailing_blank_line_count() {
    awk '
        NF { blank_count = 0; next }
        { blank_count++ }
        END { print blank_count + 0 }
    ' "$1"
}

check_message_whitespace() {
    local result=0
    local commit message_file

    message_file=$(mktemp)
    for commit in "$@"; do
        write_commit_message "$commit" "$message_file"
        if grep -qE '[[:blank:]]$' "$message_file"; then
            report_commit "$commit" " (trailing whitespace)"
            result=1
        fi
        if (($(trailing_blank_line_count "$message_file") > 0)); then
            report_commit "$commit" " (trailing blank line)"
            result=1
        fi
    done
    rm -f "$message_file"

    if ((result == 0)); then
        pass "commit message whitespace"
    else
        fail "commit message whitespace" \
             "run scripts/format-patch over the same base..head range."
    fi
}

is_text_file() {
    [[ -f $1 ]] && LC_ALL=C grep -Iq '' "$1"
}

check_file_endings() {
    local result=0
    local path blank_count

    for path in "$@"; do
        is_text_file "$path" || continue
        blank_count=$(trailing_blank_line_count "$path")
        if ((blank_count > 0)); then
            printf '  %s ends with %d blank line(s)\n' "$path" "$blank_count"
            result=1
        fi
    done

    if ((result == 0)); then
        pass "file trailing blank lines"
    else
        fail "file trailing blank lines" \
             "remove the blank lines after the last line of the reported files."
    fi
}

touches_documentation() {
    local path

    for path in "$@"; do
        case "$path" in
            Documentation/* | *.rst) return 0 ;;
        esac
    done
    return 1
}

check_documentation() {
    local output_file
    local -a lint_files

    if ! touches_documentation "$@"; then
        skip "documentation build" "no documentation file changed."
        return
    fi

    if ! command -v "${SPHINXBUILD:-sphinx-build}" >/dev/null 2>&1; then
        skip "documentation build" "sphinx-build is missing; pip install -r Documentation/requirements.txt."
    else
        output_file=$(mktemp)
        if make -C Documentation html >"$output_file" 2>&1; then
            pass "documentation build"
        else
            grep -E 'WARNING|ERROR' "$output_file" | sed 's/^/  /'
            fail "documentation build" "run make -C Documentation html and fix every warning."
        fi
        rm -f "$output_file"
    fi

    if ! python3 -c 'import sphinxlint' >/dev/null 2>&1; then
        skip "sphinx-lint" "sphinx-lint is missing; pip install -r Documentation/requirements.txt."
        return
    fi
    mapfile -t lint_files < <(git ls-files '*.rst')
    output_file=$(mktemp)
    if python3 -m sphinxlint --enable all --disable line-too-long "${lint_files[@]}" >"$output_file" 2>&1; then
        pass "sphinx-lint"
    else
        sed 's/^/  /' "$output_file"
        fail "sphinx-lint" "fix the reported markup."
    fi
    rm -f "$output_file"
}

main() {
    local base=""
    local head="HEAD"
    local commit
    local -a commits=() message_commits=() changed_files=()

    if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
        usage
        return 0
    fi
    if (($# > 2)); then
        usage
        return 2
    fi

    if (($# >= 1)); then
        base=$1
    elif ! base=$(resolve_base); then
        fail "base commit" "pass the base explicitly, for example scripts/check-patch eola-next."
        return 1
    fi
    if (($# == 2)); then
        head=$2
    fi
    if ! git cat-file -e "$base^{commit}" 2>/dev/null; then
        fail "base commit" "pass an existing commit as the base."
        return 1
    fi
    if ! git cat-file -e "$head^{commit}" 2>/dev/null; then
        fail "head commit" "pass an existing commit as the head."
        return 1
    fi

    note "checking $(short_commit "$base")..$(short_commit "$head")"
    mapfile -t commits < <(git rev-list --reverse "$base..$head")
    if ((${#commits[@]} == 0)); then
        fail "commit range" "pick a base that leaves at least one commit to check."
        return 1
    fi
    pass "commit range"

    for commit in "${commits[@]}"; do
        is_merge_commit "$commit" || message_commits+=("$commit")
    done
    mapfile -t changed_files < <(
        {
            git diff --name-only --diff-filter=ACMRT "$base..$head"
            git diff --name-only --diff-filter=ACMRT --cached
            git diff --name-only --diff-filter=ACMRT
        } | sort -u
    )

    check_commit_signatures "${commits[@]}"
    if ((${#message_commits[@]} > 0)); then
        check_signoff "${message_commits[@]}"
        check_commit_subjects "${message_commits[@]}"
        check_body_line_length "${message_commits[@]}"
        check_body_prose "${message_commits[@]}"
        check_body_detail "${message_commits[@]}"
        check_message_whitespace "${message_commits[@]}"
    fi
    check_branch_name
    check_pull_request_title
    check_patch_whitespace "${commits[@]}"
    check_file_endings "${changed_files[@]}"
    check_documentation "${changed_files[@]}"

    if ((failure_count != 0)); then
        printf 'FAIL patch checks completed with %d failure(s).\n' "$failure_count"
        return 1
    fi
    printf 'PASS patch checks completed.\n'
}

main "$@"
